    <string name="server_title">שרת WitBox</string>
    <string name="server_label">כתובת השרת</string>
    <string name="server_help">WitBox רץ על השרת הפרטי שלך וזמין רק דרך רשת ה-Tailscale שלך. הזן את כתובת השרת: https:// עם שם ה-MagicDNS, או http:// עם כתובת 100.x.y.z.</string>
    <string name="credit">WitBox %1$s · נוצר ע\"י Avi Twil</string>
