<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="a11y_label">שליטה במכשיר – WitBox</string>
    <string name="a11y_summary">מאפשר לבוטים שלך ב-WitBox להפעיל את המכשיר, רק באישורך.</string>
    <string name="a11y_description">מאפשר לבוטים בשרת ה-WitBox הפרטי שלך לשלוט במכשיר הזה: לצלם את המסך, להקיש, להחליק, להקליד טקסט, ללחוץ על חזרה/בית ולפתוח אפליקציות.\n\nשום דבר לא קורה ללא הסכמתך: לכל בוט מוגדרת באפליקציה רמת הרשאה – אף פעם, שאל או תמיד (ברירת המחדל: אף פעם). בזמן שבוט שולט במכשיר מוצגת התראה עם כפתור עצירה. תוכן המסך נשלח רק לשרת ה-WitBox שהגדרת.</string>

    <string name="err_title">לא ניתן להתחבר ל-WitBox</string>
    <string name="err_body">האם Tailscale מחובר?\nהשרת בכתובת %1$s לא הגיב.</string>
