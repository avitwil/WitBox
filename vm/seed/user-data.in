#cloud-config
timezone: @TIMEZONE@
ssh_pwauth: true
users:
  - name: cbadmin
    gecos: Administrator
    shell: /bin/bash
    groups: [sudo, ssl-cert]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: false
    passwd: "@PASSWD_HASH@"
    ssh_authorized_keys: ["@SSH_PUBKEY@"]
package_update: true
package_upgrade: true
write_files:
  - path: /etc/skel/.xsession
    content: |
      xfce4-session
  - path: /etc/polkit-1/rules.d/45-witbox.rules
    content: |
      polkit.addRule(function(action, subject) {
        if (action.id.indexOf("org.freedesktop.color-manager.") == 0 || action.id == "org.freedesktop.packagekit.system-sources-refresh") return polkit.Result.YES;
      });
  - path: /etc/xdg/autostart/witbox-noblank.desktop
    content: |
      [Desktop Entry]
      Type=Application
      Name=No screen blanking
      Exec=sh -c "xset s off; xset -dpms; xset s noblank"
  - path: /etc/apt/preferences.d/mozilla
    content: |
      Package: *
      Pin: origin packages.mozilla.org
      Pin-Priority: 1000
  - path: /etc/apt/preferences.d/no-snap-firefox
    content: |
      Package: firefox*
      Pin: release o=Ubuntu
      Pin-Priority: -1
  - path: /etc/opt/chrome/policies/managed/witbox.json
    content: |
      {"DefaultBrowserSettingEnabled": false, "PromotionalTabsEnabled": false, "BrowserSignin": 0, "MetricsReportingEnabled": false}
  - path: /usr/local/bin/cb-display
    permissions: "0755"
    content: |
      #!/bin/sh
      # prints the X display of the calling user's desktop session (empty if none)
      for s in /tmp/.X11-unix/X*; do [ -O "$s" ] && { echo ":${s#/tmp/.X11-unix/X}"; exit 0; }; done
runcmd:
  - install -d -m 0755 /etc/apt/keyrings
  - curl -fsSL https://packages.mozilla.org/apt/repo-signing-key.gpg -o /etc/apt/keyrings/packages.mozilla.org.asc
  - echo "deb [signed-by=/etc/apt/keyrings/packages.mozilla.org.asc] https://packages.mozilla.org/apt mozilla main" > /etc/apt/sources.list.d/mozilla.list
  - apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends xfce4 xfce4-terminal xfce4-taskmanager xfce4-whiskermenu-plugin mousepad ristretto thunar-archive-plugin xarchiver dbus-x11 xrdp xorgxrdp x11-xserver-utils xdg-utils xdg-user-dirs desktop-file-utils adwaita-icon-theme-full greybird-gtk-theme elementary-xfce-icon-theme gvfs gvfs-backends policykit-1 fonts-noto-core fonts-noto-color-emoji fonts-liberation fonts-dejavu culmus hunspell-he
  - DEBIAN_FRONTEND=noninteractive apt-get install -y bindfs firefox libreoffice-writer libreoffice-calc libreoffice-impress libreoffice-gtk3 python3-pip python3-venv git curl wget unzip zip jq ffmpeg imagemagick xdotool xclip nodejs npm atril file-roller
  - curl -fsSL -o /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb && DEBIAN_FRONTEND=noninteractive apt-get install -y /tmp/chrome.deb; rm -f /tmp/chrome.deb
  - DEBIAN_FRONTEND=noninteractive apt-get purge -y xfce4-screensaver light-locker gnome-keyring || true
  - adduser xrdp ssl-cert
  - groupadd -f bots
  - install -d -m 2775 -g bots /srv/shared
  - sed -i 's/^#\?HOME_MODE.*/HOME_MODE 0700/' /etc/login.defs
  - chmod 700 /home/cbadmin; cp /etc/skel/.xsession /home/cbadmin/.xsession; chown cbadmin:cbadmin /home/cbadmin/.xsession
  - sed -i 's/^max_bpp=.*/max_bpp=24/' /etc/xrdp/xrdp.ini
  - systemctl enable --now xrdp
  - systemctl disable --now unattended-upgrades apt-daily.timer apt-daily-upgrade.timer || true
  - touch /etc/cloud/cloud-init.disabled
  - touch /var/lib/witbox-ready
